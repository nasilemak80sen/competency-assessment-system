# Private administrator bootstrap settings.
# Copy this file to .streamlit/secrets.toml and replace both password placeholders.
# Never commit secrets.toml or paste its contents into source control.
#
# Add more administrators as additional [admins.<unique_key>] tables.

[admins.system]
username = "admin"
password = "SET_ADMIN_PASSWORD_PRIVATELY"
display_name = "System Administrator"

[admins.relt2026]
username = "RELT2026"
password = "SET_RELT_PASSWORD_PRIVATELY"
display_name = "RELT Administrator"
